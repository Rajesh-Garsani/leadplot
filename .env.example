# Run python setup_local.py to generate .env with private random passwords.
ADMIN_PASSWORD=
APP_SECRET=
N8N_API_TOKEN=
PORT=8000
# Optional legacy fallbacks. Prefer saving integrations through the Connections UI.
APIFY_API_KEYS=
APIFY_ACTOR_ID=compass~crawler-google-places
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# dry_run writes .eml files; smtp is enabled separately per approved batch.
EMAIL_PROVIDER=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=http://127.0.0.1:8000
SENDER_POSTAL_ADDRESS=
COOKIE_SECURE=false
