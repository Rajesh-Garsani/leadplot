    {
      "parameters": {
        "jsCode": "const target = Math.max(1, Number($('On form submission').first().json.LeadCount || 50));\n\nconst qualified = $input.all().filter((item) => {\n  const j = item.json ?? {};\n\n  const website = String(j.website ?? '').trim();\n  const normalizedWebsite = website.toLowerCase();\n  const hasNoWebsite =\n    !website ||\n    normalizedWebsite === 'null' ||\n    normalizedWebsite === 'n/a' ||\n    normalizedWebsite === 'undefined';\n\n  const rating = Number(j.totalScore ?? 0);\n  const reviewCount = Number(j.reviewsCount ?? 0);\n  const recentReviews = Array.isArray(j.reviews) ? j.reviews : [];\n  const hasRecentReview = recentReviews.length > 0;\n\n  const isClosed =\n    j.permanentlyClosed === true ||\n    j.temporarilyClosed === true ||\n    j.closed === true;\n\n  return (\n    hasNoWebsite &&\n    rating >= 2 &&\n    reviewCount >= 30 &&\n    hasRecentReview &&\n    !isClosed\n  );\n});\n\nreturn qualified.slice(0, target);"
      },
